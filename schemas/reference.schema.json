{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora.studio/schemas/reference.schema.json",
  "title": "AurorA reference analysis",
  "type": "object",
  "required": ["source", "medium", "requirements", "project_fit", "confidence"],
  "properties": {
    "source": { "type": "string" },
    "medium": { "type": "string" },
    "requirements": {
      "type": "object",
      "properties": {
        "true_3d": { "type": "boolean" },
        "character_rig": { "type": "boolean" },
        "tracking": { "type": "boolean" },
        "compositing": { "type": "boolean" },
        "motion_graphics": { "type": "boolean" }
      },
      "additionalProperties": true
    },
    "project_fit": { "type": "object" },
    "asset_queries": { "type": "array", "items": { "type": "string" } },
    "mood": { "type": "object" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
  },
  "additionalProperties": true
}
