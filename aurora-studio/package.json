{
  "name": "aurora-studio-local",
  "version": "0.2.0",
  "private": true,
  "description": "AurorA Studio foundation CLI and agent knowledge layer",
  "type": "module",
  "bin": {
    "aurora-studio": "./bin/aurora-studio.mjs"
  },
  "scripts": {
    "setup": "node ./bin/aurora-studio.mjs setup",
    "doctor": "node ./bin/aurora-studio.mjs doctor",
    "tools": "node ./bin/aurora-studio.mjs tools",
    "route": "node ./bin/aurora-studio.mjs route",
    "test": "node --test",
    "discover": "node ./bin/aurora-studio.mjs discover",
    "validate": "node ./bin/aurora-studio.mjs validate"
  },
  "engines": {
    "node": ">=22"
  }
}
