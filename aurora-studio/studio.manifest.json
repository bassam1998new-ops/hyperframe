{
  "schema_version": 1,
  "studio_version": "0.1.0-dev",
  "channel": "dev",
  "name": "AurorA Studio",
  "modes": ["direct", "director"],
  "core": {
    "knowledge_first": true,
    "ui_last": true,
    "learn_only_after_approval": true
  },
  "tools": {
    "hyperframe": { "required": true },
    "blender": { "required": false },
    "after_effects": { "required": false }
  },
  "integrations": {
    "obsidian": { "required": false, "role": "knowledge_ui" }
  },
  "hooks": {
    "preflight": { "enabled": true, "implemented": true },
    "post_approval": { "enabled": true, "implemented": false, "blocked_by": "finalize_command" },
    "post_update": { "enabled": true, "implemented": false, "blocked_by": "updater" }
  }
}
