{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AurorA Studio Blender Job",
  "type": "object",
  "required": ["schema_version", "id", "operation", "render", "quality"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "operation": { "enum": ["script", "render"] },
    "source_blend": { "type": ["string", "null"] },
    "script": { "type": ["string", "null"] },
    "output": { "type": ["string", "null"] },
    "render": {
      "type": "object",
      "properties": {
        "frame": { "type": "integer", "minimum": 0 },
        "animation": { "type": "boolean" },
        "format": { "type": ["string", "null"] }
      }
    },
    "quality": { "enum": ["draft", "normal", "premium", "hero"] },
    "notes": { "type": "array", "items": { "type": "string" } }
  },
  "anyOf": [
    { "properties": { "source_blend": { "type": "string" } }, "required": ["source_blend"] },
    { "properties": { "script": { "type": "string" } }, "required": ["script"] }
  ],
  "additionalProperties": true
}
