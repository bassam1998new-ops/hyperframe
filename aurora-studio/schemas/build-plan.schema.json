{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AurorA Studio Build Plan",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "summary", "route", "shots"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending", "completed"] },
    "summary": { "type": "string" },
    "route": {
      "type": "array",
      "items": { "enum": ["hyperframe", "blender", "after_effects"] }
    },
    "shots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "purpose", "engine", "inputs", "asset_ids", "output", "quality"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "engine": { "enum": ["hyperframe", "blender", "after_effects"] },
          "duration_seconds": { "type": ["number", "null"], "minimum": 0 },
          "inputs": { "type": "array", "items": { "type": "string" } },
          "asset_ids": { "type": "array", "items": { "type": "string" } },
          "output": { "type": "string" },
          "quality": { "enum": ["draft", "normal", "premium", "hero"] },
          "success_criteria": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "array", "items": { "type": "string" } },
          "handoff": {
            "type": ["object", "null"],
            "properties": {
              "from": { "enum": ["hyperframe", "blender", "after_effects"] },
              "to": { "enum": ["hyperframe", "blender", "after_effects"] },
              "format": { "type": "string" },
              "notes": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
