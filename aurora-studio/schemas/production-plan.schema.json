{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AurorA Studio Production Plan",
  "type": "object",
  "required": [
    "schema_version",
    "task",
    "mode",
    "route",
    "stages"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "direct",
        "director"
      ]
    },
    "route": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "route_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "route_confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "alternatives": {
      "type": "array"
    },
    "budget": {
      "type": "object"
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "status",
          "human_approval_required",
          "skippable",
          "success_criteria"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "human_approval_required": {
            "type": "boolean"
          },
          "success_criteria": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "skippable": {
            "type": "boolean"
          }
        }
      }
    },
    "intent": {
      "type": "object",
      "required": [
        "quality",
        "aspect"
      ],
      "properties": {
        "quality": {
          "enum": [
            "draft",
            "normal",
            "premium",
            "hero"
          ]
        },
        "aspect": {
          "enum": [
            "project",
            "9:16",
            "16:9",
            "1:1"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
