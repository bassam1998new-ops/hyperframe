{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AurorA Studio Asset Plan",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "summary", "needs"],
  "properties": {
    "schema_version": { "const": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending", "completed"] },
    "summary": { "type": "string" },
    "needs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "description", "kind", "decision", "selected_library_ids", "required_capabilities"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "kind": {
            "enum": ["image", "video", "model", "rig", "animation", "material", "hdri", "audio", "font", "template", "other"]
          },
          "decision": { "enum": ["reuse", "modify", "build_new", "not_needed"] },
          "selected_library_ids": {
            "type": "array",
            "items": { "type": "string" }
          },
          "required_capabilities": {
            "type": "array",
            "items": { "type": "string" }
          },
          "search_queries": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": {
            "type": "array",
            "items": { "type": "string" }
          },
          "confidence": {
            "type": ["number", "null"],
            "minimum": 0,
            "maximum": 1
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
