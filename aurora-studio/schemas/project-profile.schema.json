{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AurorA Studio Project Profile",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "product",
    "purpose",
    "brand",
    "content",
    "creative"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "offer": {
      "type": "string"
    },
    "positioning": {
      "type": "string"
    },
    "brand": {
      "type": "object",
      "required": [
        "personality",
        "colors",
        "fonts",
        "logo_paths",
        "avoid"
      ],
      "properties": {
        "personality": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logo_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "content": {
      "type": "object"
    },
    "creative": {
      "type": "object"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "website": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
