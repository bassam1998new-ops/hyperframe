{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AurorA Studio Project Profile",
  "type": "object",
  "required": [
    "schema_version",
    "project_id",
    "product",
    "purpose",
    "brand",
    "content",
    "creative"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "product": {
      "type": "string"
    },
    "purpose": {
      "type": "string"
    },
    "audience": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "offer": {
      "type": "string"
    },
    "positioning": {
      "type": "string"
    },
    "brand": {
      "type": "object",
      "required": [
        "personality",
        "colors",
        "fonts",
        "logo_paths",
        "avoid"
      ],
      "properties": {
        "personality": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "colors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fonts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "logo_paths": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "content": {
      "type": "object",
      "properties": {
        "channels": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "default_formats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "languages": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recurring_series": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "creative": {
      "type": "object",
      "properties": {
        "preferred_moods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "avoid_moods": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "recurring_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "website": {
      "type": "string"
    },
    "claims_to_protect": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "value"
        ],
        "properties": {
          "type": {
            "enum": [
              "owner",
              "website",
              "local_file",
              "other"
            ]
          },
          "value": {
            "type": "string"
          },
          "checked_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "audience_context": {
      "type": "object",
      "properties": {
        "knowledge_level": {
          "type": "string"
        },
        "priorities": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
