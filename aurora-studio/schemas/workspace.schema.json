{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aurora-studio.dev/schemas/workspace.schema.json",
  "title": "AurorA Studio Workspace",
  "type": "object",
  "required": [
    "schema_version",
    "studio",
    "default_mode",
    "project",
    "tools",
    "resources",
    "learning"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "studio": {
      "const": "AurorA Studio"
    },
    "created_at": {
      "type": "string"
    },
    "updated_at": {
      "type": "string"
    },
    "default_mode": {
      "enum": [
        "direct",
        "director"
      ]
    },
    "project": {
      "type": "object",
      "required": [
        "product",
        "purpose"
      ],
      "properties": {
        "product": {
          "type": "string"
        },
        "purpose": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "required",
          "available"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "available": {
            "type": "boolean"
          },
          "detected_by": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "integrations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "required",
          "available"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "available": {
            "type": "boolean"
          },
          "detected_by": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "resources": {
      "type": "object",
      "properties": {
        "chatgpt_browser": {
          "type": "boolean"
        },
        "google_flow": {
          "type": "boolean"
        },
        "meta_ai": {
          "type": "boolean"
        },
        "elevenlabs": {
          "type": "boolean"
        },
        "local_paths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "browser_control": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    },
    "learning": {
      "type": "object",
      "required": [
        "approved_only"
      ],
      "properties": {
        "decision_log": {
          "type": "string"
        },
        "lesson_log": {
          "type": "string"
        },
        "approved_only": {
          "type": "boolean"
        }
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "mode",
        "cap_usd",
        "approval_threshold_usd"
      ],
      "properties": {
        "mode": {
          "enum": [
            "observe",
            "warn",
            "cap"
          ]
        },
        "cap_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "approval_threshold_usd": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "tool_paths": {
      "type": "object",
      "properties": {
        "blender": {
          "type": [
            "string",
            "null"
          ]
        },
        "after_effects": {
          "type": [
            "string",
            "null"
          ]
        },
        "ffmpeg": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
