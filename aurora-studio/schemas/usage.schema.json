{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AurorA Studio Provider Usage Record",
  "type": "object",
  "required": ["schema_version", "id", "timestamp", "run_id", "phase", "provider", "operation", "quantity", "unit"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "timestamp": { "type": "string" },
    "run_id": { "type": "string", "minLength": 1 },
    "phase": { "enum": ["estimate", "actual"] },
    "provider": { "type": "string", "minLength": 1 },
    "operation": { "type": "string", "minLength": 1 },
    "model": { "type": ["string", "null"] },
    "quantity": { "type": "number", "minimum": 0 },
    "unit": { "type": "string", "minLength": 1 },
    "usd": { "type": ["number", "null"], "minimum": 0 },
    "output_count": { "type": ["integer", "null"], "minimum": 0 },
    "resolution": { "type": ["string", "null"] },
    "note": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
